volatile int period;
// "timer" : stores the value of TIMER1 
volatile int timer;
//const int threshold = 60; // some threshold number.
volatile int spin_delay; //define spin delay - initially 90 deg turn
// --- ISR: an interrupt function that resets and reads the timer value
ISR(PCINT2_vect) //when the pin changes
{	
  if (PIND & 0b00001000) { // if PD3 true then set timer to zero.
    // resets the timer to zero on a rising edge,
    TCNT1 = 0;
  } else { // else if PD0 is false store timer value.
      // and stores the timer value in a variable ("timer") on a falling edge (or vice versa).
    timer = TCNT1;
  }
}
// --- initColor: initializes the interrupt and timer 
void initColor()
{
  // a.	Initialize your I/O pins
  DDRD |= 0b00010000; //PD4 is output rest input
  DDRD &= 0b00001000; //PD3 is input
  // b. Initialize my pin change interrupt
  PCICR |= 0b00000100; //PD3 input
  // c.	Initialize your timer
  TCCR1A = 0;
  TCCR1B = 0b00000001;
}
// --- getColor: calculates the period of the sensor output wave and returns it as a variable
int getColor()
{
  // a.	Enable the specific bit for your Pin Change Interrupt
  PCMSK2 |= 0b00001000;   
  // b.	Add a short delay (5 ~ 10 milliseconds)
  _delay_ms(5);
  // c.	Disable the specific bit for your pin change interrupt
  // (to prevent further interrupts until you call getColor again)
  PCMSK2  &= ~0b00001000;
  // d.	Return the period in units of time
  return 2*timer;
}
void drive_forward(int time) {
  DDRB = 0b00001111; // enable output pins
  TCCR1B &= 0b00000110;
  	PORTB = (PORTB & 0b11110000) | 0b00000110; //set pin 9 & 10 high
	_delay_ms(time);
}
void drive_backward(int time) {
  DDRB = 0b00001111; // enable output pins
  TCCR1B &= 0b00000110;
  	PORTB = (PORTB & 0b11110000) | 0b00001001; //set pin 8 & 11 high
	_delay_ms(time);
}
void turn_left(int time) {
  DDRB = 0b00001111; // enable output pins
  TCCR1B &= 0b00000110;
  	PORTB = (PORTB & 0b11110000) | 0b00001010; //set pin 9 and 11 high
	_delay_ms(time);
}
void turn_right(int time) {
  DDRB = 0b00001111; // enable output pins
  TCCR1B &= 0b00000110;
  	PORTB = (PORTB & 0b11110000) | 0b00000101; //set pin 8 and 10 high
	_delay_ms(time);
}
void stop() {
  DDRB = 0b00001111; // enable output pins
  TCCR1B &= 0b00000110;
  	PORTB &= 0b11110000; //set pins 8-11 low
}
int main(void){ // setup code that only runs once
  // set pins 8 and 9 as outputs for "left" motor
  init();
  initColor();
  sei();
  Serial.begin(9600);

  //int color; //yellow = 0, blue = 1
  int black_bound = 7600;
  int blue_bound = 2000;
  //int start_period;
  int period = getColor(); 
  int spin_delay = 550; 
  while(1){
    while(period<black_bound){
      drive_forward(10);
      initColor();
      period = getColor();
      }
    stop();
    //drive_backward(200);
    for (int i = 0; i <= spin_delay; i = i + 1){
      turn_left(1);
    }
    //spin_delay = rand()%1000;//srand()%8000;; 
    if (spin_delay >= 1000){
      drive_forward(100); 
      spin_delay = 0; 
    }
    //start_seed = start_seed + 1; 
    spin_delay = spin_delay + 100; 
    initColor();
    period = getColor();
  }
}


